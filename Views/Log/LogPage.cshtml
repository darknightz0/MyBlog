@using MyBlog.DBModels;
@model LogForm;
@section css{
    <link rel="stylesheet" href="~/css/MyMVC.css">
}
<form asp-action="LogIn">
<label asp-for="@Model.Name"></label>
<input type="text" asp-for="@Model.Name">

<label asp-for="@Model.Password"></label>
<input type="text" asp-for="@Model.Password">

<input type="submit">
@Html.AntiForgeryToken()
</form> 
@Html.ValidationSummary()
<p><a asp-action="SignUpPage">未註冊? 點我開始註冊</a></p>